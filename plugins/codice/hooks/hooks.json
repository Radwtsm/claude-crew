{
  "description": "Regole del codice nel contesto solo al primo file di codice modificato nella sessione, una volta (prima: a ogni avvio, ~6 KB anche senza codice); python3, o python su Windows",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/regole_al_primo_uso.py\"", "timeout": 10 },
          { "type": "command", "command": "command -v python >/dev/null 2>&1 || exit 0; python \"${CLAUDE_PLUGIN_ROOT}/scripts/regole_al_primo_uso.py\" --se-manca-python3", "timeout": 10 }
        ]
      }
    ]
  }
}
